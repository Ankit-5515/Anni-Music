# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:4000

# Database & Cache
DATABASE_URL="postgresql://anni:anni_secret_password@localhost:5432/anni_music?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT & Security
JWT_ACCESS_SECRET="anni-music-super-secret-access-key-change-in-prod-2026"
JWT_REFRESH_SECRET="anni-music-super-secret-refresh-key-change-in-prod-2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
DOWNLOAD_SIGNING_SECRET="anni-music-signed-download-hmac-secret-2026"

# Google OAuth2
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# S3 / Cloudflare R2 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="anni-music-assets"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/anni-music-assets"

# External Legal Music Providers
JAMENDO_CLIENT_ID="56d30c95"
YOUTUBE_API_KEY=""
LRCLIB_BASE_URL="https://lrclib.net/api"
